# The Possessed Butler - Environment Variables Example
PORT=5001

# MongoDB Connection String (e.g. mongodb://127.0.0.1:27017/possessed_butler)
MONGODB_URI=mongodb://127.0.0.1:27017/possessed_butler

# JWT Secret for Session Authentication
JWT_SECRET=possessed-butler-jwt-secret-key-2026

# AI Provider Configuration (Optional: system runs with contextual heuristic engine if omitted)
# Supported values: gemini | openai
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_or_openai_api_key_here

# External Reputation APIs (Optional: system uses Butler Heuristic Shield & local threat feed if omitted)
GOOGLE_SAFE_BROWSING_API_KEY=your_google_safe_browsing_api_key_here
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# Google OAuth 2.0 Credentials (Gmail API)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5001/auth/google/callback
FRONTEND_URL=http://localhost:3000
